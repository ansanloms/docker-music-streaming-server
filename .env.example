# feishin から見た navidrome の URL。
# Tailscale のサイドカーを使う場合は http://navidrome.<tailnet>.ts.net の形で書く。
SERVER_URL=

# timezone
TZ=Asia/Tokyo

# music directory
MISIC_DIR=./music

# Tailscale の認証鍵。タグ付きで再利用可 (reusable)、一時ではない (non-ephemeral) 鍵を使う。
TS_AUTHKEY=

# tailnet の DNS 名 (管理画面の DNS ページに出る xxxx.ts.net)。serve の設定に使う。
TS_TAILNET=

# PORT
NAVIDROME_PORT=4533
FEISHIN_PORT=9180

# Navidrome config:
#ND_BASEURL=/navidrome
#ND_DEFAULTLANGUAGE=ja
#ND_DEFAULTTHEME=dark
#ND_SPOTIFY_ID=
#ND_SPOTIFY_SECRET=
